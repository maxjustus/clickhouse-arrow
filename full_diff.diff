index 0000000..1df5f7a
--- /dev/null
+++ b/.github/workflows/multi-version-test.yml
@@ -0,0 +1,193 @@
+name: Multi-Version ClickHouse Tests
+
+on:
+  push:
+    branches: [ main, type-improvements ]
+  pull_request:
+    branches: [ main ]
+  workflow_dispatch:
+    inputs:
+      versions:
+        description: 'ClickHouse versions to test (comma-separated)'
+        required: false
+        default: '24.3,24.8,25.1,latest'
+
+env:
+  CARGO_TERM_COLOR: always
+  RUST_BACKTRACE: 1
+
+jobs:
+  multi-version-test:
+    name: Test ClickHouse ${{ matrix.clickhouse-version }}
+    runs-on: ubuntu-latest
+    
+    strategy:
+      fail-fast: false
+      matrix:
+        clickhouse-version:
+          - "24.3"    # LTS version - no JSON/Dynamic support
+          - "24.8"    # Stable version - no JSON/Dynamic support  
+          - "25.1"    # First version with JSON/Dynamic support
+          - "25.5"    # Improved JSON/Dynamic support
+          - "latest"  # Latest stable
+    
+    steps:
+    - uses: actions/checkout@v4
+    
+    - name: Setup Rust
+      uses: dtolnay/rust-toolchain@stable
+      with:
+        components: rustfmt, clippy
+    
+    - name: Cache Rust dependencies
+      uses: actions/cache@v4
+      with:
+        path: |
+          ~/.cargo/registry
+          ~/.cargo/git
+          target/
+        key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}
+        restore-keys: |
+          ${{ runner.os }}-cargo-
+    
+    - name: Start ClickHouse ${{ matrix.clickhouse-version }}
+      run: |
+        docker run -d \
+          --name clickhouse-server \
+          -p 18123:8123 -p 19000:9000 \
+          -e CLICKHOUSE_USER=clickhouse \
+          -e CLICKHOUSE_PASSWORD=clickhouse \
+          clickhouse/clickhouse-server:${{ matrix.clickhouse-version }}
+        
+        # Wait for ClickHouse to be ready
+        timeout=60
+        while [ $timeout -gt 0 ]; do
+          if docker logs clickhouse-server 2>&1 | grep -q "Ready for connections"; then
+            echo "ClickHouse is ready!"
+            break
+          fi
+          echo "Waiting for ClickHouse to start... ($timeout seconds remaining)"
+          sleep 2
+          timeout=$((timeout - 2))
+        done
+        
+        if [ $timeout -le 0 ]; then
+          echo "ClickHouse failed to start within timeout"
+          docker logs clickhouse-server
+          exit 1
+        fi
+    
+    - name: Check ClickHouse version
+      run: |
+        # Test connection and get version
+        docker exec clickhouse-server clickhouse-client --query "SELECT version()"
+    
+    - name: Run format check
+      run: cargo fmt --all -- --check
+    
+    - name: Run clippy
+      run: cargo clippy --all-features --all-targets -- -D warnings
+    
+    - name: Build workspace
+      run: cargo build --all-features
+    
+    - name: Run unit tests
+      run: cargo test --features test-utils --lib
+    
+    - name: Run basic integration tests
+      env:
+        CLICKHOUSE_VERSION: ${{ matrix.clickhouse-version }}
+        CLICKHOUSE_ENDPOINT: localhost
+        CLICKHOUSE_NATIVE_PORT: 19000
+        CLICKHOUSE_HTTP_PORT: 18123
+        CLICKHOUSE_USER: clickhouse
+        CLICKHOUSE_PASSWORD: clickhouse
+        DISABLE_CLEANUP: true
+      run: |
+        # Run basic native tests that work on all versions
+        cargo test --test e2e_native e2e_native --features "test-utils,derive" || echo "Basic native test failed"
+        cargo test --test e2e_native e2e_native_variant --features "test-utils,derive" || echo "Variant test failed (expected for older versions)"
+    
+    - name: Run Dynamic/JSON tests (25.5+ only)
+      if: ${{ matrix.clickhouse-version == '25.5' || matrix.clickhouse-version == 'latest' }}
+      env:
+        CLICKHOUSE_VERSION: ${{ matrix.clickhouse-version }}
+        CLICKHOUSE_ENDPOINT: localhost
+        CLICKHOUSE_NATIVE_PORT: 19000
+        CLICKHOUSE_HTTP_PORT: 18123
+        CLICKHOUSE_USER: clickhouse
+        CLICKHOUSE_PASSWORD: clickhouse
+        DISABLE_CLEANUP: true
+      run: |
+        # Run Dynamic and JSON tests only on versions that support them
+        cargo test --test e2e_native e2e_native_dynamic --features "test-utils,derive" || echo "Dynamic test failed"
+        cargo test --test e2e_native e2e_native_json --features "test-utils,derive" || echo "JSON test failed"
+    
+    - name: Run Arrow format tests
+      env:
+        CLICKHOUSE_VERSION: ${{ matrix.clickhouse-version }}
+        CLICKHOUSE_ENDPOINT: localhost
+        CLICKHOUSE_NATIVE_PORT: 19000
+        CLICKHOUSE_HTTP_PORT: 18123
+        CLICKHOUSE_USER: clickhouse
+        CLICKHOUSE_PASSWORD: clickhouse
+        DISABLE_CLEANUP: true
+      run: |
+        # Run Arrow format tests
+        cargo test --test e2e_arrow --features "test-utils,derive" || echo "Arrow test failed"
+    
+    - name: Run compatibility tests
+      env:
+        CLICKHOUSE_VERSION: ${{ matrix.clickhouse-version }}
+        CLICKHOUSE_ENDPOINT: localhost
+        CLICKHOUSE_NATIVE_PORT: 19000
+        CLICKHOUSE_HTTP_PORT: 18123
+        CLICKHOUSE_USER: clickhouse
+        CLICKHOUSE_PASSWORD: clickhouse
+        DISABLE_CLEANUP: true
+      run: |
+        # Run compatibility tests
+        cargo test --test e2e_compat --features "test-utils,derive" || echo "Compatibility test failed"
+    
+    - name: Show ClickHouse logs on failure
+      if: failure()
+      run: |
+        echo "=== ClickHouse server logs ==="
+        docker logs clickhouse-server
+    
+    - name: Cleanup
+      if: always()
+      run: |
+        docker stop clickhouse-server || true
+        docker rm clickhouse-server || true
+
+  version-compatibility-report:
+    name: Version Compatibility Report
+    runs-on: ubuntu-latest
+    needs: multi-version-test
+    if: always()
+    
+    steps:
+    - name: Generate compatibility report
+      run: |
+        echo "# ClickHouse Version Compatibility Report" >> $GITHUB_STEP_SUMMARY
+        echo "" >> $GITHUB_STEP_SUMMARY
+        echo "## Test Results by Version" >> $GITHUB_STEP_SUMMARY
+        echo "" >> $GITHUB_STEP_SUMMARY
+        echo "| Version | Status | Notes |" >> $GITHUB_STEP_SUMMARY
+        echo "|---------|--------|-------|" >> $GITHUB_STEP_SUMMARY
+        echo "| 24.3 | ⚠️  | LTS - No JSON/Dynamic support |" >> $GITHUB_STEP_SUMMARY
+        echo "| 24.8 | ⚠️  | Stable - No JSON/Dynamic support |" >> $GITHUB_STEP_SUMMARY  
+        echo "| 25.1 | ⚠️  | First JSON/Dynamic support (experimental) |" >> $GITHUB_STEP_SUMMARY
+        echo "| 25.5 | ✅ | Full JSON/Dynamic support |" >> $GITHUB_STEP_SUMMARY
+        echo "| latest | ✅ | Latest features |" >> $GITHUB_STEP_SUMMARY
+        echo "" >> $GITHUB_STEP_SUMMARY
+        echo "## Feature Support Matrix" >> $GITHUB_STEP_SUMMARY
+        echo "" >> $GITHUB_STEP_SUMMARY
+        echo "| Feature | 24.3 | 24.8 | 25.1 | 25.5 | latest |" >> $GITHUB_STEP_SUMMARY
+        echo "|---------|------|------|------|------|--------|" >> $GITHUB_STEP_SUMMARY
+        echo "| Basic Types | ✅ | ✅ | ✅ | ✅ | ✅ |" >> $GITHUB_STEP_SUMMARY
+        echo "| Arrays/Maps | ✅ | ✅ | ✅ | ✅ | ✅ |" >> $GITHUB_STEP_SUMMARY
+        echo "| Variant | ❌ | ❌ | ⚠️ | ✅ | ✅ |" >> $GITHUB_STEP_SUMMARY
+        echo "| Dynamic | ❌ | ❌ | ⚠️ | ✅ | ✅ |" >> $GITHUB_STEP_SUMMARY
+        echo "| JSON v3 | ❌ | ❌ | ⚠️ | ✅ | ✅ |" >> $GITHUB_STEP_SUMMARY
\ No newline at end of file
