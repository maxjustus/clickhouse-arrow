+
+        assert_variant!(&values[1], 1, Value::Date(crate::native::values::Date(19723)));
+        assert_variant!(&values[2], 2, Value::UInt64(42));
+    }
+
+    #[test]
+    fn test_variant_multitype_sorting() {
+        let variant_type = Type::Variant(vec![
+            Type::UInt64,
